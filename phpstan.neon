includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Read each model's casts() body, so cast attributes (enums, dates, JSON) get their real types.
    parseModelCastsMethod: true
    paths:
        - app
        - routes
    # tests/ is left out: PHPStan can't see the $this that Pest binds inside test closures.
